 @model GioHangViewModel

    <style>
        .container {
            background-color: white;
            padding: 20px;
        }

        /* Main product container */
        .product-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
        }

        /* Product image section */
        .product-image {
            max-width: 100%;
            height: auto;
            display: block;
            margin: 0 auto;
        }

        /* Thumbnail gallery */
        .thumbnail-gallery {
            display: flex;
            justify-content: center;
            margin-top: 10px;
        }

        .thumbnail {
            width: 60px;
            height: 60px;
            margin: 5px;
            cursor: pointer;
            border: 2px solid transparent;
        }

        .thumbnail:hover {
            border: 2px solid #ff6347; /* Orange border on hover */
        }

        .selected-thumbnail {
            border: 2px solid #ff6347; /* Orange border for selected thumbnail */
        }

        /* Product details section */
        .product-details {
            max-width: 500px;
            padding: 20px;
        }

        .product-title {
            font-size: 28px;
            font-weight: bold;
        }

        .product-description {
            font-size: 16px;
            color: #555;
        }

        .product-price {
            font-size: 24px;
            color: #e5533d;
            font-weight: bold;
        }

        /* Quantity control styling */
        .quantity-control {
            display: flex;
            align-items: center;
            margin: 10px 0;
        }

        .quantity-control button {
            width: 40px;
            height: 40px;
        }

        .quantity-input {
            width: 60px;
            text-align: center;
            font-size: 18px;
            margin: 0 10px;
        }

        /* Add to cart and buy buttons */
        .action-buttons {
            margin: 20px 0;
        }

        .btn {
            padding: 10px 20px;
            font-size: 16px;
            margin-right: 10px;
            border-radius: 4px;
        }

        .btn-danger {
            background-color: #e5533d;
            border: none;
        }

        .btn-danger:hover {
            background-color: #c9432b;
        }

        .btn-primary {
            background-color: #007bff;
            border: none;
        }

        .btn-primary:hover {
            background-color: #0056b3;
        }

        /* Cart message styling */
        #cart-message {
            font-size: 16px;
            color: green;
        }
    </style>
<form asp-action="Details" asp-controller="Home" method="post">
